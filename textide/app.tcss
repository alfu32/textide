#file-tree {
    width: 1fr;
    border: heavy $accent;
}

#git-panel {
    width: 1fr;
    border: heavy $accent;
}
#git-panel-container{
}
#git-panel-branch{
    width: 1;
    height: 1;
}
#git-panel-changes{
    height: 1fr;
}
#git-panel-commit-message{
    height: 1fr;
}
#git-panel-commits{
    height: 1fr;
}

#editors {
    width: 2fr;
    height:2fr;
    border: heavy #555555;
}

#editors > #tab-horizontal > #tab-bar {
    width: auto;
    height: 1;
    min-height: 1;
    max-height: 1;
    layout: horizontal;
    overflow: hidden hidden;
    border: none;
}
#editors > #tab-horizontal > #tab-bar > #before,#editors > #tab-horizontal > #tab-bar > #after {
  width: 25;
  min-width: 25;
  max-width: 25;
}

#editors > #tab-horizontal > #editor {
    overflow-y: scroll;
    scrollbar-gutter: stable;
}

/* make tab text snug */
#tab-bar > .tab-name {
  padding: 0 1 0 1;
  height: 1;
  min-height: 1;
  max-height: 1;
}
/* make tab text snug */
#tab-bar > .tab-selected {
  color:$accent;
}

/* make the × super-tight */
#tab-bar > .tab-close {
  padding: 0;
  width: 3;
  min-width: 3;
  max-width: 3;
  height: 1;
  min-height: 1;
  max-height: 1;
  text-align: center;
}
#git-commit-msg{
}

#left-panel{
  layout: horizontal;
  width: 1fr;
}
#right-panel{
  layout: vertical;
  width: 2fr;
}
#vertical-tab-parent > #vertical-tab-buttons{
  layout: vertical;
  width: 5;
  min-width: 5;
  max-width: 5;
}
#vertical-tab-parent > #vertical-tab-buttons > .vertical-tab-button{
  content-align: center middle;
  width: 5;
  min-width: 5;
  max-width: 5;
  height: 3;
  min-height: 3;
  max-height: 3;
  margin:0;
  padding:0;
  color:gray;
}
#vertical-tab-parent > #vertical-tab-buttons > .vertical-tab-button.vertical-tab-button-active{
  color:$accent
}

#terminal-shell{
    height:1fr;
}